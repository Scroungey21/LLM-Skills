# Copy this file to `.env` at the repo root and fill in real values before running
# `docker-compose up`. Every key here is consumed somewhere in docker-compose.yml;
# see that file's `environment:` blocks for exactly which service reads which var.

# --- Engine ---

# SQLite connection string, read by engine/app/db.py (SQLModel/SQLAlchemy). The
# `engine` service in docker-compose.yml mounts a named volume at /data so this
# file survives `docker-compose down`/`up`; a SQLAlchemy absolute-path sqlite URL
# needs FOUR leading slashes (sqlite:// + the absolute path /data/data.sqlite).
DATABASE_URL=sqlite:////data/data.sqlite
# Host-side port for the `engine` container (docker-compose.yml's `ports:` mapping). The
# container always listens on 8000 internally regardless of this value -- only change this if
# 8000 is already taken on this machine by something unrelated (confirmed to happen: a stray
# process/container can silently intercept some connections rather than failing to bind,
# which surfaces as intermittent, hard-to-diagnose empty/wrong responses). If you change this,
# also update NEXT_PUBLIC_ENGINE_URL below to the same port, then rebuild the console
# (`docker-compose up --build console`) -- that value is compiled into the browser bundle at
# build time, so a plain restart with the new .env value alone has no effect on it.
ENGINE_HOST_PORT=8000

# Python stdlib `logging` level for the root logger (engine/app/logging_config.py, P9-REQ-2.x)
# -- every log record, including uvicorn's own request/access/error logs, is emitted as one
# JSON object per line at or above this level. One of the standard `logging` level names
# (DEBUG/INFO/WARNING/ERROR/CRITICAL). Defaults to INFO when unset.
LOG_LEVEL=INFO

# Golden-set regression worker scheduled job polling interval in seconds.
REGRESSION_WORKER_INTERVAL_SECONDS=10

# Render job queue worker's polling interval in seconds (engine/app/main.py) -- how often the
# background APScheduler worker checks for newly-enqueued render_jobs rows to pick up.
RENDER_WORKER_INTERVAL_SECONDS=10

# Pipeline orchestrator tick's polling interval in seconds (engine/app/main.py, design.md §4.5)
# -- how often the tick scans every non-terminal project for its next advanceable step.
ORCHESTRATOR_TICK_SECONDS=15


# Root directory for generated audio/caption files (engine/app/audio/pipeline.py,
# Phase 4 task 4.12) — WAV/SRT/VTT outputs land under $DATA_DIR/audio/. Shares the
# same /data named volume as DATABASE_URL above so generated files also survive
# `docker-compose down`/`up`. Defaults to engine/data/ (relative to the engine
# package) when unset, for running the engine outside compose.
DATA_DIR=/data

# RSS/Atom ingestion scheduler's polling interval in minutes (engine/app/ingestion/scheduler.py,
# RD-13) -- one global interval shared by every enabled source, not configurable per-source.
INGESTION_INTERVAL_MINUTES=30

# Discord incoming webhook URL — the single outbound notification channel (RD-2,
# tech-news-pipeline design.md §6/§7) for tie-break, Gate 1, Gate 2, and
# fact-check-flag events. No SMTP/OAuth path is planned. Create one via a Discord
# channel's Settings > Integrations > Webhooks. Not yet called by any Phase 1 code
# (notify() lands in a later phase) but wired through docker-compose.yml now.
DISCORD_WEBHOOK_URL=

# OpenCode Zen API key for the scorer/scriptwriter/editor/fact-checker LLM calls.
# Left blank on purpose: the exact model identifiers/provider routing are
# UNRESOLVED per RD-3 (tech-news-pipeline design.md §7) until Phase 3 — do not
# guess a value here. Populate once RD-3 is closed.
OPENCODE_ZEN_API_KEY=

# --- v4 addendum: additional Phase A model providers (design.md §5) ---
# Never read by any v1 pipeline code path yet — Phase 3 wires actual provider calls.
# model_providers rows (engine/app/seed_providers.py) hold provider *metadata* only; the
# actual credential values live here exclusively (RD-21), never in the database.

# Google AI Studio (Gemini models) — pay-as-you-go API key.
GOOGLE_AI_STUDIO_API_KEY=

# Anthropic API/Console — standard Claude API billing, separate from a Claude Pro/Max
# consumer subscription (see v4-addendum requirements.md V4-REQ-4.6: subscription-session
# reuse is explicitly not implemented).
ANTHROPIC_API_KEY=

# Ollama Cloud — hosted inference, larger models than local hardware can typically run.
OLLAMA_CLOUD_API_KEY=

# LM Studio (local) — local OpenAI-compatible server; base URL + port, no credential.
LM_STUDIO_BASE_URL=http://localhost:1234

# Ollama (local) — local server; base URL + port, no credential.
OLLAMA_LOCAL_BASE_URL=http://localhost:11434

# Base URL of the `tts` container's API (dots.tts SOAR -- the sole narration backend; see
# TTS_BACKEND below). Inside docker-compose this resolves over the compose network by
# service name (http://tts:8004); use a host-reachable URL instead when running the engine
# outside compose. GET /api/model-info identifies the loaded backend so clients can reject
# a stale/legacy service on the same port.
TTS_BASE_URL=http://tts:8004

# --- Advanced: path overrides ---
# The five vars below are almost never needed. Each one's own module auto-probes both the host
# repo layout and the flat Docker container layout (see engine/Dockerfile) and only raises if
# NEITHER resolves and the var is unset -- under a stock docker-compose setup they resolve
# correctly with nothing set here. Set one explicitly only after changing where its target
# directory lives relative to engine/app/, or when running the engine directly on the host
# from an unusual working directory.

# Component manifest JSON directory override (engine/app/manifests.py). Auto-resolves to
# <repo root>/manifests (host) or /app/manifests (container).
MANIFESTS_DIR=

# Design tokens package directory override (engine/app/api/design_tokens.py,
# engine/app/api/niche_config.py). Auto-resolves to <repo root>/packages/design-tokens (host)
# or /app/packages/design-tokens (container).
DESIGN_TOKENS_DIR=

# Remotion renderer package directory override (engine/app/render/remotion_client.py) --
# where render-cli.mjs lives. Auto-resolves to <repo root>/renderer (host) or /app/renderer
# (container).
RENDERER_DIR=

# Few-shot example JSON directory override (engine/app/synthesis/prompts.py). Auto-resolves to
# <repo root>/few_shot_examples (host) or /app/few_shot_examples (container).
FEW_SHOT_EXAMPLES_DIR=

# Scratch directory for a render attempt's in-progress picture-frame sequence
# (engine/app/render/remotion_client.py) -- always cleaned up when a render attempt returns,
# success or failure; never holds a final asset. Defaults to $DATA_DIR/render_scratch.
RENDER_SCRATCH_DIR=

# Subprocess timeouts, in seconds, for the two external processes a render attempt shells out
# to (engine/app/render/remotion_client.py): the Remotion/Chromium render itself, and the
# ffmpeg mux step that follows it. Raise these if renders are timing out on slower hardware.
NODE_RENDER_TIMEOUT_SECONDS=1800
RENDER_MUX_TIMEOUT_SECONDS=600

# --- TUI & internal timeouts ---

# Fifth independent BackgroundScheduler job's tick interval, in seconds
# (engine/app/main.py:253) -- probes the database and other tracked components each tick.
# Defaults to 20 when unset.
HEALTH_MONITOR_INTERVAL_SECONDS=20

# Subprocess timeout, in seconds, for real bulk-path `omp` task calls (run_omp_task's default
# when a caller doesn't pass its own timeout_s) -- engine/app/synthesis/omp_client.py:42.
# Defaults to 300 when unset.
OMP_TASK_TIMEOUT_SECONDS=300

# Subprocess timeout, in seconds, for lightweight `omp` probes (verify_omp_headless's 5-word
# echo, get_omp_effort_capabilities()'s `models ls` listing) -- these have no business
# inheriting the bulk-task budget above -- engine/app/synthesis/omp_client.py:48. Defaults to
# 30 when unset.
OMP_PROBE_TIMEOUT_SECONDS=30


# Base URL the standalone Focus TUI (tui/) talks to (tui/yttechnews_tui/config.py:26-28) --
# deliberately its own variable, distinct from ENGINE_URL above, because that one is Docker
# Compose's container-internal DNS name and does not resolve from a host shell. When unset,
# falls back to http://localhost:<ENGINE_HOST_PORT>.
TUI_ENGINE_URL=

# How often the TUI's Queue/Focus screens re-fetch from the engine in the background, in
# seconds (tui/yttechnews_tui/config.py:34). Suspended entirely while any modal is open.
# Defaults to 15 when unset.
TUI_POLL_INTERVAL_SECONDS=15

# Original ambient beds are generated lazily in this directory and rotate by niche/video.
# A niche may still override the selection with `strategy_bundle.background_music`.
BGM_LIBRARY_DIR=

# dots.tts SOAR is the sole narration backend. Pace is learned from the reviewed
# reference performance; generated waveforms are never sped up or reverberated.
TTS_BACKEND=dots
DOTS_TTS_MODEL=dots-studio/dots.tts-soar
DOTS_TTS_DEFAULT_VOICE=warm-informational
DOTS_TTS_PRECISION=bfloat16
DOTS_TTS_OPTIMIZE=0
DOTS_TTS_NUM_STEPS=16
DOTS_TTS_CHUNK_MAX_WORDS=56
NARRATION_TEMPO=1.2
DOTS_TTS_GUIDANCE_SCALE=1.2
DOTS_TTS_SPEAKER_SCALE=1.5
DOTS_TTS_SEED=20260829

# Host-visible delivery root and day-by-day staging calendar configuration.
OUTPUT_DIR=/output
RELEASE_TIMEZONE=Africa/Casablanca
RELEASE_CALENDAR_MONTHS_AHEAD=2

# --- Console ---

# Base URL the console's root layout uses for its one server-side fetch (GET /design-tokens,
# at request time, so every page's CSS custom properties are set before first paint — P7-REQ-
# 12.3). Inside docker-compose this resolves over the compose network by service name
# (http://engine:8000); use http://localhost:8000 (or equivalent) when running console outside
# compose against a local engine.
ENGINE_URL=http://engine:8000

# Base URL the console's CLIENT-SIDE code (lib/api.ts, every interactive fetch and the /events
# SSE subscription) uses to reach the engine directly from the browser — distinct from
# ENGINE_URL above because this one must be BROWSER-reachable, not just reachable from inside
# the console container. The compose-internal service name (http://engine:8000) does not
# resolve from a browser on the host, so this defaults to the host-published port instead.
# NEXT_PUBLIC_-prefixed vars are compiled into the client bundle by `next build`, not read from
# the container's environment at runtime (docker-compose.yml passes this as a `build.args`
# entry for exactly that reason) — under compose, changing it needs `up --build`, not a restart.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# Comma-separated list of origins the engine's CORS policy allows (engine/app/main.py) — must
# include whatever origin the browser actually loads the console from, or every client-side
# fetch above is silently blocked by the browser (not the server — the request still reaches
# the engine, but the browser refuses to hand the response to the console's JavaScript).
# Defaults cover both common local access patterns (docker-compose's published console port,
# and 127.0.0.1 for direct non-compose runs) since they're different origins to a browser even
# though both reach the same machine. No auth/session exists anywhere in this codebase (a
# deliberate non-goal), so there is no credential this setting could leak — it exists purely so
# the intended browser origin is explicit and reachable, not as a security boundary.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# VoiceStudio (optional, shared by all channels; docker compose --profile voicestudio up -d voicestudio).
# Any random string; clients send it as a Bearer token. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
VOICESTUDIO_API_KEY=
# VOICESTUDIO_TAG=0.5.6
